<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    
    <xacro:macro name="wheel_link" params="prefix">
        <link name="${prefix}_wheel_link">
            <visual>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_length}"/>
                </geometry>
                <origin xyz="0 0 0" rpy="0 ${pi / 2.0} 0"/>
                <material name="charcoal"/>
            </visual>
        </link>
    </xacro:macro>
    
    <link name="base_link">
        <visual>
            <geometry>
                <box size="${base_width} ${base_length} ${base_height}"/>
            </geometry>
            <origin xyz="0 0 ${base_height / 2}" rpy="0 0 0"/>
            <material name="orange"/>
        </visual>
    </link>

    <link name="crab_link">
        <visual>
            <geometry>
            <mesh filename="package://my_robot_description/meshes/crab.stl"
                    scale="1.0 1.0 1.0"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <material name="orange"/>
        </visual>
    </link>

    <xacro:wheel_link prefix="right"/>
    <xacro:wheel_link prefix="left"/>

    <link name="base_footprint_link"/>

    <joint name="base_right_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="right_wheel_link"/>
        <origin xyz="${(base_width / 2.0 + wheel_length / 2.0)} 0 0" rpy="0 0 0"/>
        <axis xyz="1 0 0"/>
    </joint>

    <joint name="base_left_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="left_wheel_link"/>
        <origin xyz="${-(base_width / 2.0 + wheel_length / 2.0)} 0 0" rpy="0 0 0"/>
        <axis xyz="1 0 0"/>
    </joint>

    <joint name="base_joint" type="fixed">
        <parent link="base_footprint_link"/>
        <child  link="base_link"/>
        <origin xyz="0 0 0.2" rpy="0 0 0"/>
    </joint>

    <joint name="base_crab_joint" type="fixed">
        <parent link="base_link"/>  
        <child  link="crab_link"/>
        <origin xyz="0 0 0.5" rpy="0 0 0"/>
    </joint>
</robot>